#!/usr/bin/env bash
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMD_NAME="$(basename "$0")"

# Capture an explicit BRAIN_VAULT override (pins the vault, bypasses the switcher).
ENV_BRAIN_VAULT="${BRAIN_VAULT:-}"
BRAIN_ROOT="${BRAIN_ROOT:-${SYNAPSE_HOME:-$HOME/Synapse}}"
VAULTS_DIR="$BRAIN_ROOT/vaults"
ACTIVE_VAULT_FILE="$BRAIN_ROOT/.active-vault"

# Resolve the active vault: explicit env override > named active vault > default.
resolve_vault() {
  if [[ -n "$ENV_BRAIN_VAULT" ]]; then printf '%s' "$ENV_BRAIN_VAULT"; return; fi
  if [[ -f "$ACTIVE_VAULT_FILE" ]]; then
    local n; n="$(tr -d '[:space:]' < "$ACTIVE_VAULT_FILE" 2>/dev/null)"
    if [[ -n "$n" && -d "$VAULTS_DIR/$n" ]]; then printf '%s' "$VAULTS_DIR/$n"; return; fi
  fi
  printf '%s' "$BRAIN_ROOT/vault"
}

BRAIN_VAULT="$(resolve_vault)"
BRAIN_BOOT="${BRAIN_BOOT:-$BRAIN_VAULT/AGENTS.md}"
BRAIN_WORKFLOW="${BRAIN_WORKFLOW:-$BRAIN_VAULT/_meta/workflow.md}"
BRAIN_GLOBAL_AGENTS="${BRAIN_GLOBAL_AGENTS:-$HOME/AGENTS.md}"
BRAIN_SKILLS_DIR="${BRAIN_SKILLS_DIR:-$BRAIN_VAULT/skills}"

vault_hash() {
  if [[ -f "$BRAIN_VAULT/index.md" ]]; then
    # Use sha256sum (Linux), shasum (macOS), or md5sum as fallback
    if command -v sha256sum >/dev/null 2>&1; then
      sha256sum "$BRAIN_VAULT/index.md" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
      shasum -a 256 "$BRAIN_VAULT/index.md" 2>/dev/null | awk '{print $1}'
    elif command -v md5sum >/dev/null 2>&1; then
      md5sum "$BRAIN_VAULT/index.md" 2>/dev/null | awk '{print $1}'
    else
      # Fallback to cksum if nothing else is available
      cksum "$BRAIN_VAULT/index.md" 2>/dev/null | awk '{print $1}'
    fi
  else
    printf 'none'
  fi
}

BRAIN_SESSION_ID="${BRAIN_SESSION_ID:-$(date +%Y%m%d-%H%M%S)-$$}"
BRAIN_VAULT_HASH="${BRAIN_VAULT_HASH:-$(vault_hash)}"

export BRAIN_ROOT BRAIN_VAULT BRAIN_BOOT BRAIN_WORKFLOW BRAIN_GLOBAL_AGENTS
export BRAIN_SKILLS_DIR BRAIN_SESSION_ID BRAIN_VAULT_HASH
export SYNAPSE_HOME="${SYNAPSE_HOME:-$BRAIN_ROOT}"
export OBSIDIAN_VAULT_PATH="${OBSIDIAN_VAULT_PATH:-$BRAIN_VAULT}"
export OBSIDIAN_WIKI_REPO="${OBSIDIAN_WIKI_REPO:-$BRAIN_ROOT}"
export OBSIDIAN_LINK_FORMAT="${OBSIDIAN_LINK_FORMAT:-wikilink}"

usage() {
  cat <<EOF
$CMD_NAME — Synapse: persistent memory bootstrap for agentic CLIs

Synapse is an LLM Wiki (Karpathy's pattern): immutable raw/ sources, an LLM-owned
wiki of interlinked Markdown, and a schema (AGENTS.md) the agent follows to maintain it.

Usage:
  $CMD_NAME <cli> [args...]   run an agent CLI with the vault environment loaded
  $CMD_NAME vault [name]     list vaults, or switch to / create vault <name>
  $CMD_NAME setup [target]   install agent context (claude-code|codex|cursor|gemini|opencode);
                             no args = list targets + configured status
  $CMD_NAME onboard [...]    one-shot: upgrade engine + setup + hooks + seed + doctor
  $CMD_NAME upgrade          sync vault engine files from installed templates
  $CMD_NAME hooks [install]  wire the continuous-loop hooks into ~/.claude/settings.json ('print' to preview)
  $CMD_NAME status           vault active? session id, staleness

  Wiki operations (Karpathy: ingest -> query -> lint):
  $CMD_NAME ingest <src>     record a source under raw/, create a linked sources/ page, log it
  $CMD_NAME query <query>    ranked retrieval (lexical, or semantic via the built index)
  $CMD_NAME query --all <q>  fuse ranked results across named vaults (RRF)
  $CMD_NAME file <cat> <ttl> file knowledge back as a wiki page (index + log) — compounds query
  $CMD_NAME lint [--strict]  health-check the wiki: validate + dedup + skill deps (= check)
  $CMD_NAME metrics          loop metrics: size, growth, activity, retrieval, stall signal
  $CMD_NAME pack export|import|list   shareable memory packs (tar.gz of wiki subtrees)

  $CMD_NAME search [opts]    filter notes by query, tag, or title (grep-based lookup)
  $CMD_NAME digest           (re)write _meta/digest.md — a compact map of the vault
  $CMD_NAME index [--backend bm25|tfidf|embeddings|hybrid]   build optional retrieval index (default: bm25)
  $CMD_NAME skill <cmd>      skill scorecards: list | use | rate | show | suggest | deps
  $CMD_NAME check [--strict] alias for lint
  $CMD_NAME doctor           verify boot files, deps, hooks, Cursor rule, engine, index
  $CMD_NAME which <cmd>      resolve command (and if Synapse wraps it)
  $CMD_NAME reinit           idempotently (re)write the shell-rc block
  $CMD_NAME env              print environment

Search options:
  --tag <tag>       filter by tag
  --title <title>   filter by title
  --exact           exact string match (no regex)

Examples:
  $CMD_NAME onboard
  $CMD_NAME setup cursor
  $CMD_NAME codex
  $CMD_NAME claude
  $CMD_NAME search --tag security
  $CMD_NAME search "FastAPI rate limit"

Legacy: \`brain\` is a symlink to \`synapse\` when installed via install.sh.
EOF
}

doctor() {
  local rc=0 path mark
  printf '== boot files ==\n'
  for path in "$BRAIN_BOOT" "$BRAIN_VAULT/index.md" "$BRAIN_VAULT/_meta/workflow.md" "$BRAIN_GLOBAL_AGENTS"; do
    if [[ -f "$path" ]]; then
      printf 'ok   %s\n' "$path"
    else
      printf 'miss %s\n' "$path"
      rc=1
    fi
  done

  printf '\n== dependencies ==\n'
  if command -v python3 >/dev/null 2>&1; then
    printf 'ok   python3 (%s)\n' "$(command -v python3)"
  else
    printf 'miss python3 (required)\n'
    rc=1
  fi
  if command -v jq >/dev/null 2>&1; then
    printf 'ok   jq (%s)\n' "$(command -v jq)"
  else
    printf 'warn jq (needed for Claude SessionStart hook)\n'
  fi

  printf '\n== engine ==\n'
  local eng_ver="" tpl_ver="" tpl_meta
  [[ -f "$BRAIN_VAULT/_meta/ENGINE_VERSION" ]] && eng_ver="$(tr -d '[:space:]' < "$BRAIN_VAULT/_meta/ENGINE_VERSION")"
  tpl_meta="$(resolve_templates)"
  if [[ -n "$tpl_meta" && -f "$tpl_meta/vault/_meta/ENGINE_VERSION" ]]; then
    tpl_ver="$(tr -d '[:space:]' < "$tpl_meta/vault/_meta/ENGINE_VERSION")"
  fi
  for path in wiki.py search.py validate.py metrics.py vault_config.py; do
    if [[ -f "$BRAIN_VAULT/_meta/$path" ]]; then
      printf 'ok   _meta/%s\n' "$path"
    else
      printf 'miss _meta/%s  (run: %s upgrade)\n' "$path" "$CMD_NAME"
      rc=1
    fi
  done
  if [[ -n "$eng_ver" && -n "$tpl_ver" && "$eng_ver" != "$tpl_ver" ]]; then
    printf 'warn engine drift: vault=%s templates=%s  (run: %s upgrade)\n' "$eng_ver" "$tpl_ver" "$CMD_NAME"
  elif [[ -n "$eng_ver" ]]; then
    printf 'ok   ENGINE_VERSION %s\n' "$eng_ver"
  else
    printf 'warn ENGINE_VERSION missing  (run: %s upgrade)\n' "$CMD_NAME"
  fi

  printf '\n== integrations ==\n'
  # Claude hooks
  local settings="$HOME/.claude/settings.json"
  if [[ -f "$settings" ]] && grep -q '_meta/hooks/prompt-retrieve.sh' "$settings" 2>/dev/null; then
    printf 'ok   Claude Code hooks wired (%s)\n' "$settings"
  elif command -v claude >/dev/null 2>&1 || [[ -d "$HOME/.claude" ]]; then
    printf 'warn Claude Code present but hooks not wired  (run: %s hooks install)\n' "$CMD_NAME"
  else
    printf 'skip Claude Code (not detected)\n'
  fi
  # Cursor rule
  local cursor_rule=""
  if [[ -f "$PWD/.cursor/rules/synapse.mdc" ]]; then
    cursor_rule="$PWD/.cursor/rules/synapse.mdc"
  elif [[ -f "$HOME/.cursor/rules/synapse.mdc" ]]; then
    cursor_rule="$HOME/.cursor/rules/synapse.mdc"
  fi
  if [[ -n "$cursor_rule" ]]; then
    printf 'ok   Cursor rule (%s)\n' "$cursor_rule"
  else
    printf 'warn Cursor rule missing  (run: %s setup cursor)\n' "$CMD_NAME"
  fi
  local cursor_hooks=""
  if [[ -f "$PWD/.cursor/hooks.json" ]] && grep -q 'cursor-session-start' "$PWD/.cursor/hooks.json" 2>/dev/null; then
    cursor_hooks="$PWD/.cursor/hooks.json"
  elif [[ -f "$HOME/.cursor/hooks.json" ]] && grep -q 'cursor-session-start' "$HOME/.cursor/hooks.json" 2>/dev/null; then
    cursor_hooks="$HOME/.cursor/hooks.json"
  fi
  if [[ -n "$cursor_hooks" ]]; then
    printf 'ok   Cursor hooks (%s)\n' "$cursor_hooks"
    if [[ ! -f "$BRAIN_VAULT/_meta/hooks/cursor-session-start.sh" ]]; then
      printf 'miss Cursor hook scripts in vault  (run: %s upgrade)\n' "$CMD_NAME"
      rc=1
    fi
  elif [[ -n "$cursor_rule" ]]; then
    printf 'warn Cursor hooks missing  (re-run: %s setup cursor)\n' "$CMD_NAME"
  fi
  # Codex
  if [[ -f "$PWD/AGENTS.md" ]] && grep -q 'synapse query' "$PWD/AGENTS.md" 2>/dev/null; then
    printf 'ok   Codex/OpenCode AGENTS.md (project)\n'
  elif [[ -f "$HOME/.codex/AGENTS.md" ]] && grep -q 'synapse query' "$HOME/.codex/AGENTS.md" 2>/dev/null; then
    printf 'ok   Codex AGENTS.md (global ~/.codex)\n'
  elif command -v codex >/dev/null 2>&1 || [[ -d "$HOME/.codex" ]]; then
    printf 'warn Codex present but Synapse AGENTS.md not found  (run: %s setup codex)\n' "$CMD_NAME"
  else
    printf 'skip Codex (not detected)\n'
  fi
  # OpenCode
  if [[ -f "$PWD/opencode.json" ]] && grep -q 'synapse.md' "$PWD/opencode.json" 2>/dev/null; then
    printf 'ok   OpenCode opencode.json instructions\n'
  elif command -v opencode >/dev/null 2>&1; then
    printf 'warn OpenCode present but instructions not wired  (run: %s setup opencode)\n' "$CMD_NAME"
  else
    printf 'skip OpenCode (not detected)\n'
  fi
  # Gemini
  if [[ -f "$PWD/GEMINI.md" ]] || [[ -f "$HOME/GEMINI.md" ]]; then
    printf 'ok   Gemini context file present\n'
  elif command -v gemini >/dev/null 2>&1; then
    printf 'warn Gemini present but GEMINI.md missing  (run: %s setup gemini)\n' "$CMD_NAME"
  else
    printf 'skip Gemini (not detected)\n'
  fi

  printf '\n== retrieval ==\n'
  if [[ -f "$BRAIN_VAULT/_meta/search.py" ]] && command -v python3 >/dev/null 2>&1; then
    python3 "$BRAIN_VAULT/_meta/search.py" stale || true
  else
    printf 'skip index check\n'
  fi

  return "$rc"
}

status() {
  if [[ "${BRAIN_LOADED:-0}" == "1" ]]; then
    printf 'synapse: ACTIVE in this environment\n'
  else
    printf 'synapse: NOT active — start via "%s <cli>" or a shell alias\n' "$CMD_NAME"
  fi
  printf 'vault:    %s\n' "$BRAIN_VAULT"
  printf 'skills:   %s\n' "$BRAIN_SKILLS_DIR"
  printf 'session:  %s\n' "$BRAIN_SESSION_ID"
  local now; now="$(vault_hash)"
  if [[ "${BRAIN_LOADED:-0}" == "1" && "$now" != "$BRAIN_VAULT_HASH" ]]; then
    printf 'hash:     %s  (STALE — vault changed since load; now %s)\n' "$BRAIN_VAULT_HASH" "$now"
  else
    printf 'hash:     %s\n' "$now"
  fi
  doctor
}

strip_rc_block() {
  local rc="$1" tmp
  tmp="$(mktemp)"
  awk '
    /# >>> Synapse >>>/ { skip=1 }
    skip && /# <<< Synapse <<</ { skip=0; next }
    /# >>> Agent Brain Runtime >>>/ { skip=1 }
    skip && /# <<< Agent Brain Runtime <<</ { skip=0; next }
    !skip { print }
  ' "$rc" > "$tmp" && mv "$tmp" "$rc"
}

reinit() {
  local prefix="$SELF_DIR" rc default_rc
  case "${SHELL:-}" in
    *bash) default_rc="$HOME/.bashrc" ;;
    *)     default_rc="$HOME/.zshrc" ;;
  esac
  rc="${SHELL_RC:-$default_rc}"

  if [[ -f "$rc" ]]; then
    strip_rc_block "$rc"
  fi

  cat >> "$rc" <<EOF

# >>> Synapse >>>
export SYNAPSE_HOME="$BRAIN_ROOT"
export BRAIN_ROOT="$BRAIN_ROOT"
# Vault is resolved dynamically by synapse so "synapse vault <name>" applies
# immediately. Export BRAIN_VAULT yourself only to pin a specific vault.
export OBSIDIAN_WIKI_REPO="\${OBSIDIAN_WIKI_REPO:-\$BRAIN_ROOT}"
export OBSIDIAN_LINK_FORMAT="\${OBSIDIAN_LINK_FORMAT:-wikilink}"
case ":\$PATH:" in
  *":$prefix:"*) ;;
  *) export PATH="$prefix:\$PATH" ;;
esac
alias codex='synapse codex'
alias opencode='synapse opencode'
alias claude='synapse claude'
alias gemini='synapse gemini'
# <<< Synapse <<<
EOF
  printf 'synapse: rewrote Synapse block in %s\n' "$rc"
  printf 'synapse: open a new terminal (or source it) to apply.\n'
}

check() {
  local v="$BRAIN_VAULT/_meta/validate.py" d="$BRAIN_VAULT/_meta/dedup.py" sk="$BRAIN_VAULT/_meta/skill.py" rc=0
  local strict=0
  for a in "$@"; do [[ "$a" == "--strict" ]] && strict=1; done
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'synapse: python3 not found; cannot run check\n' >&2
    return 2
  fi
  if [[ -f "$v" ]]; then
    printf '== validate ==\n'
    python3 "$v" "$@" || rc=$?
  else
    printf 'synapse: no validate.py at %s\n' "$v" >&2
    rc=1
  fi
  if [[ -f "$d" ]]; then
    printf '\n== dedup (candidates) ==\n'
    if [[ "$strict" -eq 1 ]]; then
      python3 "$d" --strict || rc=$?
    else
      python3 "$d" || true
    fi
  fi
  if [[ -f "$sk" ]]; then
    printf '\n== skill deps ==\n'
    BRAIN_SKILLS_DIR="$BRAIN_SKILLS_DIR" python3 "$sk" deps || rc=$?
  fi
  if [[ -f "$BRAIN_VAULT/_meta/search.py" ]]; then
    printf '\n== retrieval index ==\n'
    if ! python3 "$BRAIN_VAULT/_meta/search.py" stale; then
      printf 'synapse: rebuilding stale index...\n'
      python3 "$BRAIN_VAULT/_meta/search.py" index --if-stale || {
        if [[ "$strict" -eq 1 ]]; then rc=1; fi
      }
    fi
    printf '\n== catalog refresh ==\n'
    python3 "$BRAIN_VAULT/_meta/search.py" digest --write || true
  fi
  return "$rc"
}

# Locate the bundled templates dir (repo checkout, installed copy, or override).
resolve_templates() {
  if [[ -n "${SYNAPSE_TEMPLATES:-}" && -d "${SYNAPSE_TEMPLATES:-}" ]]; then
    printf '%s' "$SYNAPSE_TEMPLATES"; return
  fi
  if [[ -d "$SELF_DIR/../templates" ]]; then printf '%s' "$SELF_DIR/../templates"; return; fi
  if [[ -d "$BRAIN_ROOT/templates" ]]; then printf '%s' "$BRAIN_ROOT/templates"; return; fi
  printf ''
}

# Optional retrieval layer (file-based). Delegates to _meta/search.py.
search_cmd() {
  local s="$BRAIN_VAULT/_meta/search.py"
  if [[ ! -f "$s" ]]; then
    printf 'synapse: retrieval engine not found at %s\n' "$s" >&2
    return 2
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'synapse: python3 not found; cannot run search\n' >&2
    return 2
  fi
  exec python3 "$s" "$@"
}

# Ingest: register an immutable source under raw/ with provenance, then hand the
# agent the ingest recipe (read -> summary page -> revise wiki -> index -> log).
# This is Karpathy's first operation: raw in, derived wiki out — never edit raw.
ingest_cmd() {
  local src="${1:-}" title="${2:-}" raw_dir="$BRAIN_VAULT/raw" stamp slug dest raw_rel
  if [[ -z "$src" ]]; then
    printf 'usage: %s ingest <path-or-url> [title]\n\n' "$CMD_NAME"
    printf 'Records a source under raw/ (immutable), creates a linked sources/ page\n'
    printf '(frontmatter + index.md entry + log.md entry), then prints the ingest recipe.\n'
    printf 'URLs are recorded as a stub note pointing at the source.\n'
    return 2
  fi
  mkdir -p "$raw_dir"
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  if [[ "$src" =~ ^https?:// ]]; then
    slug="$(printf '%s' "${title:-$src}" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-' | cut -c1-60)"
    [[ -n "$slug" ]] || slug="source-$(date -u +%s)"
    dest="$raw_dir/$slug.md"
    [[ -n "$title" ]] || title="$src"
    if [[ -e "$dest" ]]; then
      printf 'synapse: raw source already exists: %s (not overwriting)\n' "$dest" >&2
    else
      printf -- '---\nsource: %s\ningested: %s\nimmutable: true\n---\n\n# %s\n\nFetched from <%s>. Paste or attach the captured content below; do not edit after ingest.\n' \
        "$src" "$stamp" "$title" "$src" > "$dest"
      printf 'synapse: recorded source stub -> %s\n' "$dest"
    fi
    raw_rel="raw/$slug.md"
  elif [[ -f "$src" ]]; then
    dest="$raw_dir/$(basename "$src")"
    [[ -n "$title" ]] || title="$(basename "${src%.*}")"
    if [[ -e "$dest" ]]; then
      printf 'synapse: raw source already exists: %s (not overwriting)\n' "$dest" >&2
    else
      cp "$src" "$dest"
      printf 'synapse: copied source -> %s (immutable)\n' "$dest"
    fi
    raw_rel="raw/$(basename "$src")"
  else
    printf 'synapse: not a file or URL: %s\n' "$src" >&2
    return 2
  fi

  # Create the derived sources/ page (frontmatter + index + log) deterministically,
  # so the agent only has to fill the body — ingest is a real wiki mutation, not a memo.
  local w="$BRAIN_VAULT/_meta/wiki.py" page=""
  if [[ -f "$w" ]] && command -v python3 >/dev/null 2>&1; then
    page="$(python3 "$w" new --category sources --title "$title" \
              --source "$raw_rel" --op INGEST 2>&1)" || true
    if [[ -f "$BRAIN_VAULT/$page" ]]; then
      printf 'synapse: created %s (cites %s; cataloged in index.md, logged)\n' "$page" "$raw_rel"
    else
      printf 'synapse: %s\n' "$page" >&2
    fi
  fi

  cat <<EOF

ingest recipe (see _meta/workflow.md → Ingest):
  1. Read $raw_rel (immutable source).
  2. Fill the Takeaways in ${page:-the sources/ page} — the high-signal distillation.
  3. Revise affected wiki pages (concepts/, techniques/, projects/, analysis/, ...)
     and cross-link them with [[wikilinks]].
  4. synapse lint  (health-check the result — 0 errors).
EOF
}

# File a piece of knowledge back as a wiki page (frontmatter + index + log). The
# compounding half of query: a good answer becomes a durable page, not a one-off reply.
# `synapse file update <stem>` refreshes an existing page.
file_cmd() {
  local w="$BRAIN_VAULT/_meta/wiki.py"
  if [[ "${1:-}" == "update" ]]; then
    shift
    if [[ ! -f "$w" ]]; then
      printf 'synapse: wiki engine not found at %s\n' "$w" >&2
      return 2
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      printf 'synapse: python3 not found; cannot update a page\n' >&2
      return 2
    fi
    local stem="${1:-}"
    if [[ -z "$stem" ]]; then
      printf 'usage: %s file update <stem> [--summary S] [--tags a,b] [--link PAGE]\n' "$CMD_NAME"
      return 2
    fi
    shift
    local page
    page="$(python3 "$w" update --stem "$stem" "$@")" || return $?
    printf 'synapse: updated %s\n' "$page"
    return 0
  fi
  if [[ "${1:-}" == "" || "${2:-}" == "" ]]; then
    printf 'usage: %s file <category> <title> [--summary S] [--tags a,b] [--source SRC] [--link PAGE] [--force]\n' "$CMD_NAME"
    printf '       %s file update <stem> [--summary S] [--tags a,b] [--link PAGE]\n' "$CMD_NAME"
    printf 'categories: concepts people organizations techniques sources analysis skills projects journal\n'
    # shellcheck disable=SC2016  # backticks are literal usage hints, not command substitution
    printf 'note: refuses near-duplicates unless --force; prefer `file update <stem>`\n'
    return 2
  fi
  if [[ ! -f "$w" ]]; then
    printf 'synapse: wiki engine not found at %s\n' "$w" >&2
    return 2
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'synapse: python3 not found; cannot file a page\n' >&2
    return 2
  fi
  local category="$1" title="$2"; shift 2
  local page
  page="$(python3 "$w" new --category "$category" --title "$title" --op FILE "$@")" || return $?
  if [[ -f "$BRAIN_VAULT/$page" ]]; then
    printf 'synapse: filed %s (cataloged in index.md, logged)\n' "$page"
  else
    printf '%s\n' "$page"
  fi
}

# Wire the continuous-loop hooks into Claude Code settings (SessionStart / UserPromptSubmit
# / Stop), pointed at the active vault. Safe JSON merge: idempotent, backs up, replaces
# only Synapse-owned entries (those under _meta/hooks/). `print` emits the snippet instead.
hooks_cmd() {
  local action="${1:-install}" settings="${2:-$HOME/.claude/settings.json}"
  local hooks_dir="$BRAIN_VAULT/_meta/hooks"
  if [[ ! -d "$hooks_dir" ]]; then
    printf 'synapse: hooks not found at %s (is the vault initialized?)\n' "$hooks_dir" >&2
    return 2
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'synapse: python3 not found; cannot manage hooks\n' >&2
    return 2
  fi
  HOOKS_DIR="$hooks_dir" SETTINGS="$settings" ACTION="$action" python3 - <<'PY'
import json, os, shutil, sys

hooks_dir = os.environ["HOOKS_DIR"]
settings  = os.environ["SETTINGS"]
action    = os.environ["ACTION"]

mapping = {
    "SessionStart":     os.path.join(hooks_dir, "session-enforce.sh"),
    "UserPromptSubmit": os.path.join(hooks_dir, "prompt-retrieve.sh"),
    "Stop":             os.path.join(hooks_dir, "stop-check.sh"),
}

def entry(cmd):
    return {"hooks": [{"type": "command", "command": cmd}]}

if action == "print":
    print(json.dumps({"hooks": {e: [entry(c)] for e, c in mapping.items()}}, indent=2))
    sys.exit(0)

if action != "install":
    print(f"synapse: unknown hooks action '{action}' (install|print)", file=sys.stderr)
    sys.exit(2)

data = {}
if os.path.isfile(settings):
    try:
        data = json.load(open(settings, encoding="utf-8"))
    except Exception as exc:
        print(f"synapse: cannot parse {settings}: {exc}", file=sys.stderr)
        sys.exit(2)
    shutil.copy(settings, settings + ".bak")

hooks = data.setdefault("hooks", {})
for event, cmd in mapping.items():
    groups = hooks.setdefault(event, [])
    # drop any prior Synapse-owned command (same script basename under _meta/hooks)
    base = os.path.basename(cmd)
    kept = []
    for g in groups:
        inner = [h for h in g.get("hooks", [])
                 if not (h.get("command", "").endswith(base) and "_meta/hooks" in h.get("command", ""))]
        if inner:
            g["hooks"] = inner
            kept.append(g)
        elif not g.get("hooks"):
            kept.append(g)  # preserve unrelated empty/other-keyed groups
    kept = [g for g in kept if g.get("hooks")]
    kept.append(entry(cmd))
    hooks[event] = kept

os.makedirs(os.path.dirname(settings) or ".", exist_ok=True)
with open(settings, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
print(f"synapse: wired SessionStart / UserPromptSubmit / Stop hooks into {settings}")
print(f"         (backup at {settings}.bak)" if os.path.isfile(settings + ".bak") else "")
print("         restart Claude Code (or open a new session) to load them.")
PY
}

# Install the right agent context file for a target tool, pointed at the vault.
setup_cmd() {
  local target="${1:-}" dest_dir="${2:-$PWD}" templates
  templates="$(resolve_templates)"

  if [[ -z "$target" ]]; then
    printf 'targets (active vault: %s):\n\n' "$BRAIN_VAULT"
    local mark
    # claude-code
    if [[ -f "$dest_dir/CLAUDE.md" || -f "$HOME/CLAUDE.md" ]]; then mark="configured"; else mark="not set"; fi
    if [[ -f "$HOME/.claude/settings.json" ]] && grep -q '_meta/hooks/prompt-retrieve.sh' "$HOME/.claude/settings.json" 2>/dev/null; then
      mark="$mark + hooks"
    fi
    printf '  claude-code   %s\n' "$mark"
    # cursor
    if [[ -f "$dest_dir/.cursor/rules/synapse.mdc" ]]; then
      mark="configured (.cursor/rules/synapse.mdc)"
      if [[ -f "$dest_dir/.cursor/hooks.json" ]] && grep -q 'cursor-session-start' "$dest_dir/.cursor/hooks.json" 2>/dev/null; then
        mark="$mark + hooks"
      fi
    elif [[ -f "$dest_dir/AGENTS.md" ]]; then mark="partial (AGENTS.md only — re-run setup cursor)"
    else mark="not set"; fi
    printf '  cursor        %s\n' "$mark"
    # codex
    if [[ -f "$dest_dir/AGENTS.md" ]]; then mark="configured"
    elif [[ -f "$HOME/.codex/AGENTS.md" ]] && grep -q 'synapse query' "$HOME/.codex/AGENTS.md" 2>/dev/null; then mark="global ~/.codex/AGENTS.md"
    else mark="not set"; fi
    printf '  codex         %s\n' "$mark"
    # opencode
    if [[ -f "$dest_dir/opencode.json" ]] && grep -q 'opencode/synapse.md\|synapse.md' "$dest_dir/opencode.json" 2>/dev/null; then
      mark="configured (opencode.json + instructions)"
    elif [[ -f "$dest_dir/AGENTS.md" ]]; then mark="partial (AGENTS.md — re-run setup opencode)"
    else mark="not set"; fi
    printf '  opencode      %s\n' "$mark"
    if [[ -f "$dest_dir/GEMINI.md" || -f "$HOME/GEMINI.md" ]]; then mark="configured"; else mark="not set"; fi
    printf '  gemini        %s\n' "$mark"
    printf '\nusage: %s setup <target> [dir]\n' "$CMD_NAME"
    return 0
  fi
  if [[ -z "$templates" ]]; then
    printf 'synapse: templates not found (set SYNAPSE_TEMPLATES to the templates dir)\n' >&2
    return 2
  fi

  _install_context_file() {
    local src="$1" dst="$2" name
    name="$(basename "$dst")"
    mkdir -p "$(dirname "$dst")"
    if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
      printf 'synapse: %s already up to date (%s)\n' "$name" "$dst"
    elif [[ -f "$dst" ]]; then
      printf 'synapse: %s exists and differs — left unchanged: %s\n' "$name" "$dst" >&2
      printf '         remove it (or pass a clean dir) to reinstall the template.\n' >&2
      return 1
    else
      cp "$src" "$dst"
      printf 'synapse: installed %s -> %s\n' "$name" "$dst"
    fi
    return 0
  }

  case "$target" in
    cursor)
      local src="$templates/cursor/synapse.mdc"
      [[ -f "$src" ]] || src="$templates/../cursor/synapse.mdc"
      if [[ ! -f "$src" ]]; then src=""; fi
      local rule_dir="$dest_dir/.cursor/rules"
      local dst="$rule_dir/synapse.mdc"
      mkdir -p "$rule_dir"
      if [[ -n "$src" && -f "$src" ]]; then
        if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
          printf 'synapse: synapse.mdc already up to date (%s)\n' "$dst"
        else
          if cp "$src" "$dst"; then
            printf 'synapse: installed Cursor rule -> %s\n' "$dst"
          else
            printf 'synapse: failed to write Cursor rule -> %s\n' "$dst" >&2
            return 1
          fi
        fi
      else
        cat > "$dst" <<EOF
---
description: Synapse LLM Wiki continuous loop
alwaysApply: true
---

# Synapse

Query the vault before meaningful work: \`synapse query "<topic>"\`.
After meaningful work, distill with \`synapse file\` / update notes, then
\`synapse lint --strict\`. Vault: $BRAIN_VAULT
EOF
        printf 'synapse: installed Cursor rule (inline) -> %s\n' "$dst"
      fi
      if [[ ! -f "$dest_dir/AGENTS.md" && -f "$templates/AGENTS.md" ]]; then
        cp "$templates/AGENTS.md" "$dest_dir/AGENTS.md"
        printf 'synapse: installed AGENTS.md -> %s/AGENTS.md\n' "$dest_dir"
      fi
      # Ensure Cursor hook scripts exist in the vault, then wire .cursor/hooks.json
      mkdir -p "$BRAIN_VAULT/_meta/hooks"
      local hs
      for hs in cursor-session-start.sh cursor-stop.sh; do
        if [[ -f "$templates/vault/_meta/hooks/$hs" ]]; then
          cp "$templates/vault/_meta/hooks/$hs" "$BRAIN_VAULT/_meta/hooks/$hs"
          chmod +x "$BRAIN_VAULT/_meta/hooks/$hs" 2>/dev/null || true
        fi
      done
      local start_hook="$BRAIN_VAULT/_meta/hooks/cursor-session-start.sh"
      local stop_hook="$BRAIN_VAULT/_meta/hooks/cursor-stop.sh"
      if [[ -f "$start_hook" && -f "$stop_hook" ]]; then
        mkdir -p "$dest_dir/.cursor"
        DEST="$dest_dir" START="$start_hook" STOP="$stop_hook" python3 - <<'PY'
import json, os
dest = os.environ["DEST"]
path = os.path.join(dest, ".cursor", "hooks.json")
data = {"version": 1, "hooks": {}}
if os.path.isfile(path):
    try:
        data = json.load(open(path, encoding="utf-8"))
    except Exception as exc:
        print(f"synapse: cannot parse {path}: {exc} — rewriting Synapse entries", flush=True)
        data = {"version": 1, "hooks": {}}
data.setdefault("version", 1)
hooks = data.setdefault("hooks", {})
start_cmd = os.environ["START"]
stop_cmd = os.environ["STOP"]

def keep_non_synapse(entries):
    out = []
    for e in entries or []:
        cmd = e.get("command", "") if isinstance(e, dict) else ""
        if "cursor-session-start" in cmd or "cursor-stop" in cmd:
            continue
        out.append(e)
    return out

hooks["sessionStart"] = keep_non_synapse(hooks.get("sessionStart")) + [{"command": start_cmd}]
hooks["stop"] = keep_non_synapse(hooks.get("stop")) + [{"command": stop_cmd, "loop_limit": 1}]
with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
print(f"synapse: wired Cursor sessionStart/stop hooks -> {path}")
PY
      else
        printf 'synapse: Cursor hook scripts missing in vault (run: %s upgrade)\n' "$CMD_NAME" >&2
      fi
      printf 'vault: %s\n' "$BRAIN_VAULT"
      return 0
      ;;
    opencode)
      [[ -f "$templates/AGENTS.md" ]] || { printf 'synapse: missing AGENTS.md template\n' >&2; return 2; }
      _install_context_file "$templates/AGENTS.md" "$dest_dir/AGENTS.md" || true
      mkdir -p "$dest_dir/.opencode"
      local instr_src="$templates/opencode/synapse.md"
      [[ -f "$instr_src" ]] || instr_src="$templates/../opencode/synapse.md"
      if [[ -f "$instr_src" ]]; then
        cp "$instr_src" "$dest_dir/.opencode/synapse.md"
        printf 'synapse: installed OpenCode instructions -> %s/.opencode/synapse.md\n' "$dest_dir"
      fi
      # Merge instructions into opencode.json (idempotent)
      DEST="$dest_dir" python3 - <<'PY'
import json, os
dest = os.environ["DEST"]
path = os.path.join(dest, "opencode.json")
data = {}
if os.path.isfile(path):
    try:
        data = json.load(open(path, encoding="utf-8"))
    except Exception as exc:
        print(f"synapse: cannot parse {path}: {exc}", flush=True)
        raise SystemExit(0)
instr = data.setdefault("instructions", [])
if not isinstance(instr, list):
    instr = [instr]
    data["instructions"] = instr
entry = ".opencode/synapse.md"
if entry not in instr:
    instr.append(entry)
    data.setdefault("$schema", "https://opencode.ai/config.json")
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    print(f"synapse: wired {entry} into {path}")
else:
    print(f"synapse: {entry} already listed in {path}")
PY
      printf 'vault: %s\n' "$BRAIN_VAULT"
      return 0
      ;;
    codex)
      [[ -f "$templates/AGENTS.md" ]] || { printf 'synapse: missing AGENTS.md template\n' >&2; return 2; }
      _install_context_file "$templates/AGENTS.md" "$dest_dir/AGENTS.md" || true
      # Global Codex home bootstrap (only if missing — never overwrite personal prefs)
      if [[ -d "$HOME/.codex" && ! -f "$HOME/.codex/AGENTS.md" && ! -f "$HOME/.codex/AGENTS.override.md" ]]; then
        cp "$templates/AGENTS.md" "$HOME/.codex/AGENTS.md"
        printf 'synapse: installed global Codex bootstrap -> ~/.codex/AGENTS.md\n'
      elif [[ -f "$HOME/.codex/AGENTS.md" ]]; then
        printf 'synapse: ~/.codex/AGENTS.md already present (left unchanged)\n'
      fi
      printf 'vault: %s\n' "$BRAIN_VAULT"
      return 0
      ;;
  esac

  local src name
  case "$target" in
    claude|claude-code)     src="$templates/CLAUDE.md";  name="CLAUDE.md" ;;
    gemini)                 src="$templates/GEMINI.md";  name="GEMINI.md" ;;
    *)
      printf 'synapse: unknown target: %s (claude-code|codex|cursor|gemini|opencode)\n' "$target" >&2
      return 2 ;;
  esac
  if [[ ! -f "$src" ]]; then
    printf 'synapse: template missing: %s\n' "$src" >&2
    return 2
  fi

  mkdir -p "$dest_dir"
  local dst="$dest_dir/$name"
  if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
    printf 'synapse: %s already up to date (%s)\n' "$name" "$dst"
  elif [[ -f "$dst" ]]; then
    printf 'synapse: %s exists and differs — left unchanged: %s\n' "$name" "$dst" >&2
    printf '         remove it (or pass a clean dir) to reinstall the template.\n' >&2
  else
    cp "$src" "$dst"
    printf 'synapse: installed %s -> %s\n' "$name" "$dst"
  fi

  if [[ "$target" == claude* ]]; then
    local hooks="$BRAIN_VAULT/_meta/hooks"
    if [[ -d "$hooks" ]]; then
      printf 'hooks: %s/{session-enforce.sh,prompt-retrieve.sh,stop-check.sh}\n' "$hooks"
      printf '       run "%s hooks install" to wire the continuous loop (per-turn retrieval\n' "$CMD_NAME"
      printf '       + distill-on-close) into ~/.claude/settings.json. See README.\n'
    fi
  fi
  printf 'vault: %s\n' "$BRAIN_VAULT"
}

# Sync engine files from bundled templates into the active vault (always overwrite engines).
upgrade_cmd() {
  local templates src_meta
  templates="$(resolve_templates)"
  if [[ -z "$templates" ]]; then
    printf 'synapse: templates not found (set SYNAPSE_TEMPLATES)\n' >&2
    return 2
  fi
  src_meta="$templates/vault/_meta"
  if [[ ! -d "$src_meta" ]]; then
    printf 'synapse: engine templates missing at %s\n' "$src_meta" >&2
    return 2
  fi
  mkdir -p "$BRAIN_VAULT/_meta/hooks"
  local f
  for f in validate.py dedup.py skill.py search.py wiki.py metrics.py vault_config.py \
           synapse_lib.py pack.py \
           workflow.md taxonomy.md categories ENGINE_VERSION; do
    if [[ -f "$src_meta/$f" ]]; then
      cp "$src_meta/$f" "$BRAIN_VAULT/_meta/$f"
      printf 'synapse: upgraded _meta/%s\n' "$f"
    fi
  done
  for f in session-enforce.sh prompt-retrieve.sh stop-check.sh \
           cursor-session-start.sh cursor-stop.sh; do
    if [[ -f "$src_meta/hooks/$f" ]]; then
      cp "$src_meta/hooks/$f" "$BRAIN_VAULT/_meta/hooks/$f"
      chmod +x "$BRAIN_VAULT/_meta/hooks/$f" 2>/dev/null || true
      printf 'synapse: upgraded _meta/hooks/%s\n' "$f"
    fi
  done
  # Starter skills (only if missing — don't clobber rated scorecards)
  local sk
  for sk in distill-after-work.md file-into-vault.md; do
    if [[ -f "$templates/vault/skills/$sk" && ! -f "$BRAIN_VAULT/skills/$sk" ]]; then
      mkdir -p "$BRAIN_VAULT/skills"
      cp "$templates/vault/skills/$sk" "$BRAIN_VAULT/skills/$sk"
      printf 'synapse: seeded skill %s\n' "$sk"
    fi
  done
  chmod +x "$BRAIN_VAULT/_meta/"*.py 2>/dev/null || true
  local ver=""
  [[ -f "$BRAIN_VAULT/_meta/ENGINE_VERSION" ]] && ver="$(tr -d '[:space:]' < "$BRAIN_VAULT/_meta/ENGINE_VERSION")"
  printf 'synapse: vault engine at %s (version %s)\n' "$BRAIN_VAULT" "${ver:-unknown}"
}

# Seed demo notes into an empty-ish vault so query has something to find.
seed_cmd() {
  local templates examples force=0
  templates="$(resolve_templates)"
  [[ "${1:-}" == "--force" ]] && force=1
  if [[ -z "$templates" ]]; then
    printf 'synapse: templates not found\n' >&2
    return 2
  fi
  examples=""
  if [[ -d "$templates/examples/distillation/after" ]]; then
    examples="$templates/examples/distillation/after"
  elif [[ -d "$templates/../examples/distillation/after" ]]; then
    examples="$(cd "$templates/../examples/distillation/after" && pwd)"
  elif [[ -d "$(cd "$SELF_DIR/.." && pwd)/examples/distillation/after" ]]; then
    examples="$(cd "$SELF_DIR/.." && pwd)/examples/distillation/after"
  fi
  if [[ -z "$examples" || ! -d "$examples" ]]; then
    printf 'synapse: seed examples not found\n' >&2
    return 2
  fi
  # Count existing wiki pages (exclude skills starters / raw)
  local n=0
  local cat
  for cat in concepts techniques projects sources analysis; do
    [[ -d "$BRAIN_VAULT/$cat" ]] || continue
    n=$((n + $(find "$BRAIN_VAULT/$cat" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l | tr -d ' ')))
  done
  if [[ "$force" -eq 0 && "$n" -ge 3 ]]; then
    printf 'synapse: vault already has %s notes — skip seed (pass --force to add anyway)\n' "$n"
    return 0
  fi
  mkdir -p "$BRAIN_VAULT/concepts"
  local src stem dest
  local seeded=0
  for src in "$examples"/*.md; do
    [[ -f "$src" ]] || continue
    stem="$(basename "$src" .md)"
    dest="$BRAIN_VAULT/concepts/$stem.md"
    if [[ -f "$dest" ]]; then
      printf 'synapse: seed exists, skip %s\n' "$stem"
      continue
    fi
    cp "$src" "$dest"
    # Register in index + log via wiki.py when possible
    if [[ -f "$BRAIN_VAULT/_meta/wiki.py" ]] && command -v python3 >/dev/null 2>&1; then
      # Page already exists — just ensure index/log via a tiny python snippet
      python3 - <<PY
import os, re, sys
sys.path.insert(0, "$BRAIN_VAULT/_meta")
import wiki
stem = "$stem"
summary = "Seed note from Synapse examples/distillation."
text = open("$dest", encoding="utf-8").read()
m = re.search(r"^summary:\\s*(.+)$", text, re.M)
if m: summary = m.group(1).strip()
tags = ["knowledge"]
mt = re.search(r"^tags:\\s*\\[(.+)\\]", text, re.M)
if mt: tags = [t.strip() for t in mt.group(1).split(",") if t.strip()]
wiki.register_in_index(stem, summary, tags, "Concepts")
wiki.append_log("SEED", stem, "concepts", None)
PY
    fi
    printf 'synapse: seeded concepts/%s.md\n' "$stem"
    seeded=$((seeded + 1))
  done
  if [[ "$seeded" -gt 0 ]]; then
    # Surface one seed in hot.md
    if [[ -f "$BRAIN_VAULT/hot.md" ]] && ! grep -q 'api-auth-bearer-header' "$BRAIN_VAULT/hot.md" 2>/dev/null; then
      printf '\n- [[api-auth-bearer-header]] — seed: API auth via bearer header\n' >> "$BRAIN_VAULT/hot.md"
    fi
    printf 'synapse: seeded %s demo notes — try: %s query "bearer token auth"\n' "$seeded" "$CMD_NAME"
  else
    printf 'synapse: nothing new to seed\n'
  fi
}

# One-shot: upgrade + setup targets + hooks + seed + doctor.
onboard_cmd() {
  local target="auto" do_seed=1 do_hooks=1 dest_dir="$PWD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target) target="${2:-auto}"; shift 2 ;;
      --seed) do_seed=1; shift ;;
      --no-seed) do_seed=0; shift ;;
      --hooks) do_hooks=1; shift ;;
      --no-hooks) do_hooks=0; shift ;;
      --dir) dest_dir="${2:-$PWD}"; shift 2 ;;
      -h|--help)
        printf 'usage: %s onboard [--target auto|all|claude-code|cursor|codex|opencode|gemini|both] [--seed|--no-seed] [--hooks|--no-hooks] [--dir DIR]\n' "$CMD_NAME"
        return 0 ;;
      *) printf 'synapse: unknown onboard flag: %s\n' "$1" >&2; return 2 ;;
    esac
  done

  printf '== 1/5 upgrade engine ==\n'
  upgrade_cmd || true

  printf '\n== 2/5 setup agents ==\n'
  local do_claude=0 do_cursor=0 do_codex=0 do_opencode=0 do_gemini=0
  case "$target" in
    auto)
      if command -v claude >/dev/null 2>&1 || [[ -d "$HOME/.claude" ]]; then do_claude=1; fi
      if command -v cursor >/dev/null 2>&1 || [[ -d "$HOME/.cursor" ]] || [[ -d "$dest_dir/.cursor" ]]; then do_cursor=1; fi
      if command -v codex >/dev/null 2>&1 || [[ -d "$HOME/.codex" ]]; then do_codex=1; fi
      if command -v opencode >/dev/null 2>&1 || [[ -d "$dest_dir/.opencode" ]]; then do_opencode=1; fi
      if command -v gemini >/dev/null 2>&1; then do_gemini=1; fi
      if [[ "$do_claude" -eq 0 && "$do_cursor" -eq 0 && "$do_codex" -eq 0 && "$do_opencode" -eq 0 && "$do_gemini" -eq 0 ]]; then
        do_claude=1; do_cursor=1
      fi
      ;;
    all) do_claude=1; do_cursor=1; do_codex=1; do_opencode=1; do_gemini=1 ;;
    claude|claude-code) do_claude=1 ;;
    cursor) do_cursor=1 ;;
    codex) do_codex=1 ;;
    opencode) do_opencode=1 ;;
    gemini) do_gemini=1 ;;
    both) do_claude=1; do_cursor=1 ;;
    *) printf 'synapse: unknown --target %s\n' "$target" >&2; return 2 ;;
  esac
  [[ "$do_claude" -eq 1 ]] && setup_cmd claude-code "$dest_dir"
  [[ "$do_cursor" -eq 1 ]] && setup_cmd cursor "$dest_dir"
  [[ "$do_codex" -eq 1 ]] && setup_cmd codex "$dest_dir"
  [[ "$do_opencode" -eq 1 ]] && setup_cmd opencode "$dest_dir"
  [[ "$do_gemini" -eq 1 ]] && setup_cmd gemini "$dest_dir"

  printf '\n== 3/5 hooks ==\n'
  if [[ "$do_hooks" -eq 1 && "$do_claude" -eq 1 ]]; then
    hooks_cmd install || true
  elif [[ "$do_hooks" -eq 1 && "$do_cursor" -eq 1 ]]; then
    printf 'synapse: Cursor hooks wired in setup (sessionStart + stop); Claude hooks skipped (not a target)\n'
  elif [[ "$do_hooks" -eq 0 ]]; then
    printf 'synapse: skip hooks (--no-hooks)\n'
  else
    printf 'synapse: skip Claude hooks (no Claude target); Cursor/Codex use setup context files\n'
  fi

  printf '\n== 4/5 seed ==\n'
  if [[ "$do_seed" -eq 1 ]]; then
    seed_cmd || true
  else
    printf 'synapse: skip seed\n'
  fi

  printf '\n== 5/5 doctor ==\n'
  doctor || true
  printf '\nsynapse: onboard complete. Try: %s query "bearer auth"\n' "$CMD_NAME"
  # Critical failures only: vault + python3 + wiki engine
  local rc=0
  command -v python3 >/dev/null 2>&1 || rc=1
  [[ -d "$BRAIN_VAULT" && -f "$BRAIN_VAULT/_meta/wiki.py" ]] || rc=1
  return "$rc"
}

which_cmd() {
  local c="${1:-}" p
  if [[ -z "$c" ]]; then
    printf 'usage: %s which <cmd>\n' "$CMD_NAME" >&2
    return 2
  fi
  p="$(command -v -- "$c" 2>/dev/null)" || { printf 'synapse: command not found: %s\n' "$c" >&2; return 127; }
  printf 'command:  %s\n' "$c"
  printf 'resolves: %s\n' "$p"
  if grep -qsE "$SELF_DIR/(synapse|brain)" "$p" 2>/dev/null; then
    printf 'type:     synapse wrapper -> %s\n' "$SELF_DIR"
  else
    printf 'type:     direct binary (not wrapped by synapse)\n'
  fi
  if [[ -e "$SELF_DIR/.synapse-real/$c" ]]; then
    printf 'real:     %s\n' "$(readlink "$SELF_DIR/.synapse-real/$c" 2>/dev/null || echo "$SELF_DIR/.synapse-real/$c")"
  fi
}

# Seed a new named vault: inherit the engine + workflow from an existing vault,
# but start with an empty knowledge surface.
scaffold_vault() {
  local target="$1" seed=""
  if [[ -d "$BRAIN_VAULT/_meta" ]]; then seed="$BRAIN_VAULT"
  elif [[ -d "$BRAIN_ROOT/vault/_meta" ]]; then seed="$BRAIN_ROOT/vault"; fi

  # Karpathy LLM Wiki layout: immutable raw/ sources + the LLM-owned wiki. Scaffold the
  # core categories a coding vault uses constantly (concepts/techniques/projects/skills)
  # plus sources/ (ingest target); optional ones (people/organizations/analysis/journal,
  # see _meta/categories) are created on demand when first filed into.
  mkdir -p \
    "$target/_meta/hooks" "$target/raw" "$target/sources" \
    "$target/concepts" "$target/techniques" "$target/projects" "$target/skills"

  if [[ -n "$seed" ]]; then
    cp -R "$seed/_meta/." "$target/_meta/" 2>/dev/null || true
    [[ -f "$seed/AGENTS.md" ]] && cp "$seed/AGENTS.md" "$target/AGENTS.md"
  fi
  # shellcheck disable=SC2016  # backticks are literal Markdown, not a command substitution
  [[ -f "$target/raw/README.md" ]] || printf '# raw/ — immutable sources\n\nDrop original sources here (or let `synapse ingest` copy them in). The wiki is\nderived from these; never edit raw files in place — supersede them with a new source.\n' > "$target/raw/README.md"
  # shellcheck disable=SC2016  # backticks are literal Markdown, not a command substitution
  [[ -f "$target/index.md" ]]  || printf '# Index\n\n_Empty vault. Ingest a source (`synapse ingest <path>`), then distill it into concepts/, techniques/, projects/, skills/ (see `_meta/categories` for the full, configurable set)._\n' > "$target/index.md"
  [[ -f "$target/hot.md" ]]    || printf '# Hot\n\n_Most-used notes surface here._\n' > "$target/hot.md"
  [[ -f "$target/log.md" ]]    || printf '# Log\n' > "$target/log.md"
  # shellcheck disable=SC2016  # backticks are literal Markdown, not a command substitution
  [[ -f "$target/AGENTS.md" ]] || printf '# Vault operations\n\nSee `_meta/workflow.md`.\n' > "$target/AGENTS.md"
}

vault_cmd() {
  local name="${1:-}" active=""
  [[ -f "$ACTIVE_VAULT_FILE" ]] && active="$(tr -d '[:space:]' < "$ACTIVE_VAULT_FILE" 2>/dev/null)"

  if [[ -z "$name" ]]; then
    if [[ -n "$active" && -d "$VAULTS_DIR/$active" ]]; then
      printf 'active vault: %s  (%s)\n' "$active" "$VAULTS_DIR/$active"
    else
      printf 'active vault: default  (%s)\n' "$BRAIN_ROOT/vault"
    fi
    printf 'vaults dir:   %s\n\n' "$VAULTS_DIR"
    if compgen -G "$VAULTS_DIR/*/" >/dev/null 2>&1; then
      printf 'named vaults:\n'
      local d n
      for d in "$VAULTS_DIR"/*/; do
        n="$(basename "$d")"
        if [[ "$n" == "$active" ]]; then printf '  * %s\n' "$n"; else printf '    %s\n' "$n"; fi
      done
    else
      printf 'no named vaults yet — create/switch with: %s vault <name>\n' "$CMD_NAME"
    fi
    if [[ -n "$ENV_BRAIN_VAULT" ]]; then
      printf '\nnote: BRAIN_VAULT is pinned in your environment (%s);\n' "$ENV_BRAIN_VAULT"
      printf '      switching has no effect until you unset it or run "%s reinit".\n' "$CMD_NAME"
      return 0
    fi
    return 0
  fi

  mkdir -p "$BRAIN_ROOT"
  case "$name" in
    default|legacy)
      rm -f "$ACTIVE_VAULT_FILE"
      printf 'synapse: active vault -> default (%s)\n' "$BRAIN_ROOT/vault"
      ;;
    */*|.*)
      printf 'synapse: invalid vault name: %s\n' "$name" >&2
      return 2
      ;;
    *)
      local target="$VAULTS_DIR/$name"
      if [[ ! -d "$target" ]]; then
        printf 'synapse: creating new vault "%s"\n' "$name"
        scaffold_vault "$target"
      fi
      printf '%s\n' "$name" > "$ACTIVE_VAULT_FILE"
      printf 'synapse: active vault -> %s (%s)\n' "$name" "$target"
      ;;
  esac

  if [[ -n "$ENV_BRAIN_VAULT" ]]; then
    printf 'note: BRAIN_VAULT is pinned in your environment; run "%s reinit" and open a new shell to apply.\n' "$CMD_NAME" >&2
    return 0
  fi
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  vault)
    vault_cmd "${2:-}"
    exit $?
    ;;
  status)
    status
    exit 0
    ;;
  check|lint)
    shift
    check "$@"
    exit $?
    ;;
  ingest)
    ingest_cmd "${2:-}" "${3:-}"
    exit $?
    ;;
  file)
    shift
    file_cmd "$@"
    exit $?
    ;;
  hooks)
    hooks_cmd "${2:-install}" "${3:-$HOME/.claude/settings.json}"
    exit $?
    ;;
  metrics|stats)
    shift
    m="$BRAIN_VAULT/_meta/metrics.py"
    if [[ ! -f "$m" ]]; then
      printf 'synapse: metrics engine not found at %s\n' "$m" >&2
      exit 2
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      printf 'synapse: python3 not found; cannot run metrics\n' >&2
      exit 2
    fi
    exec python3 "$m" "$@"
    ;;
  query|index|digest)
    if [[ "$1" == "digest" && -z "${2:-}" ]]; then
      search_cmd digest --write
    else
      search_cmd "$@"
    fi
    ;;
  pack)
    shift
    p="$BRAIN_VAULT/_meta/pack.py"
    if [[ ! -f "$p" ]]; then
      printf 'synapse: pack engine not found at %s (run: %s upgrade)\n' "$p" "$CMD_NAME" >&2
      exit 2
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      printf 'synapse: python3 not found; cannot run pack\n' >&2
      exit 2
    fi
    exec python3 "$p" "$@"
    ;;
  setup)
    setup_cmd "${2:-}" "${3:-$PWD}"
    exit $?
    ;;
  upgrade)
    upgrade_cmd
    exit $?
    ;;
  seed)
    shift
    seed_cmd "$@"
    exit $?
    ;;
  onboard)
    shift
    onboard_cmd "$@"
    exit $?
    ;;
  search)
    shift
    # Delegate to the weighted, frontmatter-aware retriever (search.py), scanning
    # bodies by default; --tag/--title/--exact still work as documented.
    search_cmd search --body "$@"
    exit $?
    ;;
  skill)
    shift
    s="$BRAIN_VAULT/_meta/skill.py"
    if [[ ! -f "$s" ]]; then
      printf 'synapse: skill engine not found at %s\n' "$s" >&2
      exit 2
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      printf 'synapse: python3 not found; cannot run skill\n' >&2
      exit 2
    fi
    BRAIN_SKILLS_DIR="$BRAIN_SKILLS_DIR" exec python3 "$s" "$@"
    ;;
  reinit)
    reinit
    exit 0
    ;;
  doctor)
    doctor
    exit $?
    ;;
  which)
    which_cmd "${2:-}"
    exit $?
    ;;
  env)
    printf 'SYNAPSE_HOME=%s\n' "$SYNAPSE_HOME"
    printf 'BRAIN_ROOT=%s\n' "$BRAIN_ROOT"
    printf 'BRAIN_VAULT=%s\n' "$BRAIN_VAULT"
    printf 'BRAIN_BOOT=%s\n' "$BRAIN_BOOT"
    printf 'BRAIN_WORKFLOW=%s\n' "$BRAIN_WORKFLOW"
    printf 'BRAIN_GLOBAL_AGENTS=%s\n' "$BRAIN_GLOBAL_AGENTS"
    printf 'BRAIN_SKILLS_DIR=%s\n' "$BRAIN_SKILLS_DIR"
    printf 'BRAIN_SESSION_ID=%s\n' "$BRAIN_SESSION_ID"
    printf 'BRAIN_VAULT_HASH=%s\n' "$BRAIN_VAULT_HASH"
    printf 'BRAIN_LOADED=%s\n' "${BRAIN_LOADED:-0}"
    printf 'OBSIDIAN_VAULT_PATH=%s\n' "$OBSIDIAN_VAULT_PATH"
    printf 'OBSIDIAN_WIKI_REPO=%s\n' "$OBSIDIAN_WIKI_REPO"
    printf 'OBSIDIAN_LINK_FORMAT=%s\n' "$OBSIDIAN_LINK_FORMAT"
    exit 0
    ;;
esac

cmd="$1"
shift

if ! command -v -- "$cmd" >/dev/null 2>&1; then
  printf 'synapse: command not found: %s\n' "$cmd" >&2
  exit 127
fi

if [[ "${BRAIN_LOADED:-0}" != "1" && "${BRAIN_QUIET:-0}" != "1" ]]; then
  printf 'synapse[vault]: %s (session: %s)\n' "$BRAIN_VAULT" "$BRAIN_SESSION_ID" >&2
fi

export BRAIN_LOADED=1

# Session bootstrap for wrapped CLIs (claude/codex/gemini/…): write a short vault
# snapshot agents can read via SYNAPSE_BOOTSTRAP_PATH. Skip with SYNAPSE_NO_BOOTSTRAP=1.
if [[ "${SYNAPSE_NO_BOOTSTRAP:-0}" != "1" ]] && command -v python3 >/dev/null 2>&1 \
   && [[ -d "$BRAIN_VAULT/_meta" ]]; then
  export SYNAPSE_BOOTSTRAP_PATH="${SYNAPSE_BOOTSTRAP_PATH:-$BRAIN_VAULT/_meta/.session-bootstrap.md}"
  META="$BRAIN_VAULT/_meta" VAULT="$BRAIN_VAULT" OUT="$SYNAPSE_BOOTSTRAP_PATH" python3 - <<'PY' 2>/dev/null || true
import os
meta, vault, out = os.environ["META"], os.environ["VAULT"], os.environ["OUT"]
lines = [
    "# Synapse session bootstrap",
    "",
    f"Vault: `{vault}`",
    "",
    "Prefer these notes over re-deriving. Run `synapse query <topic>` each turn;",
    "distill after meaningful work (`synapse file` / `file update`, then `lint --strict`).",
    "",
]
hot = os.path.join(vault, "hot.md")
if os.path.isfile(hot):
    lines += ["## hot.md", "", open(hot, encoding="utf-8").read().strip()[:2000], ""]
for path, title in (
    (os.path.join(meta, "digest.md"), "digest"),
    (os.path.join(meta, "catalog.md"), "catalog"),
):
    if os.path.isfile(path):
        body = open(path, encoding="utf-8").read().strip()
        lines += [f"## {title} (head)", "", "\n".join(body.splitlines()[:40]), ""]
        break
os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
open(out, "w", encoding="utf-8").write("\n".join(lines).rstrip() + "\n")
PY
fi

exec "$cmd" "$@"
